{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "columnsector",
  "position": {
    "x": 650,
    "y": 240,
    "z": 400,
    "height": 300,
    "width": 610,
    "tabOrder": 400
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_sector"
                    }
                  },
                  "Property": "macrosector"
                }
              },
              "queryRef": "dim_sector.macrosector",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_financiero"
                    }
                  },
                  "Property": "Ingresos"
                }
              },
              "queryRef": "fact_financiero.Ingresos"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}