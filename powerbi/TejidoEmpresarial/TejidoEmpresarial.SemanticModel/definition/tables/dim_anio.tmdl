table dim_anio

	column anio
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: anio

	partition dim_anio = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\dim_anio.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Remove(_, {Character.FromNumber(65279)})),
				    Tipado = Table.TransformColumnTypes(Limpio, {{"anio", Int64.Type}})
				in
				    Tipado

	annotation PBI_ResultType = Table
